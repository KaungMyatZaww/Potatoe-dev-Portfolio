# EmailJS credentials for the contact form.
# Copy this file to `.env` for local development, and set the same keys in the
# Netlify dashboard (Site configuration → Environment variables) for deploys.
#
# Values are exposed to the client bundle by Vite — the EmailJS public key is
# intended to be public, but rotate it if it has been committed to git history.

VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key

